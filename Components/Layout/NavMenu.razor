<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Contest Manager</a>
    </div>
</div>

<style>
    .layout {
    display: flex;
    min-height: 100vh;
    font-family: sans-serif;
}

.sidebar {
    width: 240px;
    background-color: #2c3e50;
    color: white;
    transition: width 0.3s ease;
    overflow: hidden;
    position: relative;
    padding-top: 10px;
}

.sidebar.collapsed {
    width: 60px;
}

.toggle-btn {
    background: none;
    border: none;
    color: white;
    font-size: 22px;
    cursor: pointer;
    margin: 10px;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    padding: 8px 15px;
}

nav ul li a,
.menu-item {
    text-decoration: none;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 8px 10px;
    transition: background-color 0.2s;
}

nav ul li a:hover,
.menu-item:hover {
    background-color: #34495e;
}

.arrow {
    font-size: 12px;
    margin-left: 8px;
}

.submenu {
    list-style: none;
    padding-left: 20px;
    animation: slideDown 0.3s ease;
}

.submenu li a {
    font-size: 14px;
    color: #ecf0f1;
}

.submenu li a:hover {
    background-color: #3d566e;
}


.content {
    flex-grow: 1;
    background-color: #ecf0f1;
    padding: 20px;
}

</style>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <AuthorizeView Roles="Administrator, User">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="counter">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <div class="nav-item nav-link px-3">
                    <button class="nav-link" @onclick="ToggleMenu">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Setup
                    </button>

                    @if (IsSetupToggled)
                    {
                        <ul class="submenu">
                            <li><NavLink href="/user-setup">Utenti</NavLink></li>
                            <li><NavLink href="#">Ruoli</NavLink></li>
                        </ul>
                    }
                </div>
            </Authorized>
        </AuthorizeView>


    </nav>
</div>

@code{
    private bool IsSetupToggled = false;
    private void ToggleMenu() {
        IsSetupToggled = !IsSetupToggled;
    }

}
