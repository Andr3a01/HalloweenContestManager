@page "/useraccounts/create"
@using Microsoft.EntityFrameworkCore
@using HalloweenContestManager.Modelds.Entity
@inject IDbContextFactory<HalloweenContestManager.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>UserAccount</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="UserAccount" OnValidSubmit="AddUserAccount" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="username" class="form-label">UserName:</label> 
                <InputText id="username" @bind-Value="UserAccount.UserName" class="form-control" /> 
                <ValidationMessage For="() => UserAccount.UserName" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="password" class="form-label">Password:</label> 
                <InputText id="password" @bind-Value="UserAccount.Password" class="form-control" /> 
                <ValidationMessage For="() => UserAccount.Password" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="active" class="form-label">Active:</label> 
                <InputCheckbox id="active" @bind-Value="UserAccount.Active" class="form-check-input" /> 
                <ValidationMessage For="() => UserAccount.Active" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="lockedout" class="form-label">LockedOut:</label> 
                <InputCheckbox id="lockedout" @bind-Value="UserAccount.LockedOut" class="form-check-input" /> 
                <ValidationMessage For="() => UserAccount.LockedOut" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/useraccounts">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private UserAccount UserAccount { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddUserAccount()
    {
        using var context = DbFactory.CreateDbContext();
        context.UserAccounts.Add(UserAccount);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/useraccounts");
    }
}
