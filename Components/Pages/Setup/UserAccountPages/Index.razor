@page "/useraccounts"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using HalloweenContestManager.Modelds.Entity
@using HalloweenContestManager.Data
@implements IAsyncDisposable
@inject IDbContextFactory<HalloweenContestManager.Data.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="useraccounts/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.UserAccounts">
    <PropertyColumn Property="useraccount => useraccount.UserName" />
    <PropertyColumn Property="useraccount => useraccount.Password" />
    <PropertyColumn Property="useraccount => useraccount.Active" />
    <PropertyColumn Property="useraccount => useraccount.LockedOut" />

    <TemplateColumn Context="useraccount">
        <a href="@($"useraccounts/edit?id={useraccount.Id}")">Edit</a> |
        <a href="@($"useraccounts/details?id={useraccount.Id}")">Details</a> |
        <a href="@($"useraccounts/delete?id={useraccount.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
